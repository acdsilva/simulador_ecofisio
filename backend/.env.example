# Copie para .env e ajuste conforme necessário. Todos os valores são opcionais:
# sem nenhuma configuração o backend roda em memória e usa explicações locais.

# Chave da API do Google Gemini (https://aistudio.google.com/apikey).
# Se vazio, as explicações são geradas localmente (o app continua funcionando).
GEMINI_API_KEY=
# O backend descobre um modelo válido automaticamente; isto é só o preferido.
GEMINI_MODEL=gemini-2.5-flash

# MongoDB (opcional). Se vazio, usa armazenamento em memória.
MONGO_URL=
DB_NAME=ecofisiolab

# Origens permitidas no CORS (separadas por vírgula). "*" libera todas.
CORS_ORIGINS=*

# Porta do servidor.
PORT=8001
